// Prisma schema — tenancy/identity/RBAC (Phase 0) + catalog & stock (Phase 1)
// + stock transfers (Phase 2) + sales & payments (Phase 3). Later phases
// per the build roadmap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

// A company's business-verification (CAC) lifecycle — independent of
// CompanyStatus/billing. UNVERIFIED is the only state a company can be
// suspended-for-security in without also being locked out of the app (see
// the "soft reminder" design: the 5-day deadline never blocks access on
// its own, it just makes a company visible/filterable to platform staff).
enum CompanyVerificationStatus {
  UNVERIFIED // default; nothing submitted yet, or the deadline has passed with nothing submitted
  PENDING_REVIEW // certificate submitted, awaiting a platform admin's decision
  VERIFIED // reviewed and approved — shows a verified badge
  REJECTED // reviewed and rejected; the company can resubmit
  APPROVED_WITHOUT_CAC // no CAC certificate exists (e.g. not yet incorporated), but a platform admin manually approved the company to operate anyway
}

model Company {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  status            CompanyStatus @default(TRIAL)
  currency          String        @default("NGN")
  timezone          String        @default("Africa/Lagos")
  saleCounter       Int           @default(0)
  creditNoteCounter Int           @default(0)

  // Off by default — sending automated messages to a company's customers
  // is a consent-adjacent action that shouldn't silently turn on for an
  // existing company just because this feature shipped.
  debtReminderEnabled     Boolean @default(false)
  debtReminderDaysOverdue Int     @default(7)

  // Business verification (CAC). rcNumber/incorporationDate are collected
  // (optionally) at sign-up; verificationDeadline is set to createdAt + 5
  // days there too. A company with no CAC is still allowed to operate —
  // reaching the deadline with nothing submitted never blocks access on
  // its own, it only makes the company show up as overdue for a platform
  // admin to chase up or explicitly approve without one.
  rcNumber                     String?
  incorporationDate            DateTime?
  verificationStatus           CompanyVerificationStatus @default(UNVERIFIED)
  verificationDeadline         DateTime?
  cacCertificateUrl            String?
  cacSubmittedAt               DateTime?
  // Reviewer is a platform User.id (SUPER_ADMIN), stored the same
  // no-FK-relation way PlatformAuditLog.actorUserId is — platform staff
  // aren't Membership rows, so there's no scoped relation to hang off of.
  verificationReviewedAt       DateTime?
  verificationReviewedByUserId String?
  verificationNote             String? // rejection reason, or an approval note

  // Security kill switch a SUPER_ADMIN can flip independent of billing —
  // sets status to SUSPENDED (blocking the whole company, see
  // getCurrentMembership()) and remembers the prior status so re-enabling
  // restores it exactly rather than guessing ACTIVE vs TRIAL.
  statusBeforeSuspension CompanyStatus?
  disabledAt             DateTime?
  disabledByUserId       String?
  disabledReason         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships       Membership[]
  roles             Role[]
  invitations       Invitation[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  products          Product[]
  warehouses        Warehouse[]
  branches          Branch[]
  stockTransfers    StockTransfer[]
  stockMovements    StockMovement[]
  sales             Sale[]
  payments          Payment[]
  brandingSettings  BrandingSettings?
  customers         Customer[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  debtReminders     DebtReminder[]
  creditNotes       CreditNote[]
  productBatches    ProductBatch[]

  @@index([status])
  @@index([verificationStatus])
}

// ---------------------------------------------------------------------------
// Better Auth core tables (managed by the Better Auth Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Platform-level, not company-level — deliberately NOT a Membership/Role
  // grant, since those are always scoped to one Company by getScopedPrisma.
  // Someone with a platform role has no company at all; requireSuperAdmin()/
  // requirePlatformStaff() (src/lib/auth/session.ts) check this directly
  // against the raw `prisma` singleton, bypassing tenant scoping entirely
  // on purpose for the one narrow /admin surface that legitimately needs
  // to see across every company. SUPER_ADMIN can see every company
  // (view-only) and manage the SUPPORT_AGENT roster; SUPPORT_AGENT can
  // also see every company (same view-only data) and generate password
  // reset links for locked-out users, but cannot grant platform access to
  // anyone else. Null means "not platform staff" — an ordinary user.
  platformRole PlatformRole?

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@map("user")
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_AGENT
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  // Added when better-auth was bumped to ^1.7.1 to pull in @better-auth/expo
  // for mobile auth — the Prisma adapter now requires this column (paired
  // with accountId in a unique index) to distinguish which credential
  // issuer an account row came from (e.g. "local:credential" for
  // email/password vs. an OAuth provider's issuer URL).
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Staff / RBAC
// ---------------------------------------------------------------------------

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

// A Membership is a User acting as staff within one Company. This is the
// entity referenced everywhere else in the app ("who requested this
// transfer", "who recorded this sale") instead of User directly, so
// permissions and identity are always tenant-scoped.

model Membership {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String?
  role        Role?            @relation(fields: [roleId], references: [id])
  status      MembershipStatus @default(ACTIVE)
  displayName String?
  jobTitle    String?

  invitedByMembershipId String?
  invitedAt             DateTime?
  joinedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissionOverrides MembershipPermissionOverride[]

  @@unique([userId, companyId])
  @@index([companyId, status])
}

// Per-company role templates (a bundle of default permissions).

model Role {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([companyId, name])
}

// Fixed, code-defined permission catalog — seeded, not company-editable.
// Kept in sync with src/lib/auth/permissions.ts (PERMISSIONS catalog).

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  category    String
  description String

  rolePermissions     RolePermission[]
  membershipOverrides MembershipPermissionOverride[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

enum PermissionEffect {
  GRANT
  DENY
}

// Per-staff, admin-modifiable grant/deny on top of the staff member's role.
// Effective permission = (role's permissions ∪ GRANT overrides) − DENY overrides.

model MembershipPermissionOverride {
  id                    String           @id @default(cuid())
  membershipId          String
  membership            Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permissionId          String
  permission            Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect                PermissionEffect
  grantedByMembershipId String
  reason                String?
  createdAt             DateTime         @default(now())

  @@unique([membershipId, permissionId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id                    String           @id @default(cuid())
  companyId             String
  company               Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email                 String
  roleId                String
  role                  Role             @relation(fields: [roleId], references: [id])
  invitedByMembershipId String
  tokenHash             String           @unique
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime
  createdAt             DateTime         @default(now())

  @@index([companyId, email])
}

// ---------------------------------------------------------------------------
// Billing skeleton (full Paystack wiring lands in Phase 6)
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
}

model Plan {
  id               String          @id @default(cuid())
  name             String          @unique
  paystackPlanCode String?         @unique
  priceKobo        Int
  billingInterval  BillingInterval @default(MONTHLY)
  features         Json
  isActive         Boolean         @default(true)

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

model Subscription {
  id                       String             @id @default(cuid())
  companyId                String             @unique
  company                  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId                   String
  plan                     Plan               @relation(fields: [planId], references: [id])
  paystackSubscriptionCode String?
  paystackCustomerCode     String?
  status                   SubscriptionStatus @default(TRIALING)
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  trialEndsAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log (security backbone — append-only)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
}

model AuditLog {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorMembershipId String?
  actorType         AuditActorType @default(USER)
  action            String
  entityType        String
  entityId          String
  metadata          Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime       @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, action])
}

/**
 * The platform-level counterpart to AuditLog — for actions taken by
 * SUPER_ADMIN/SUPPORT_AGENT users that don't belong to any one company
 * (generating a password reset link for a locked-out user, promoting or
 * demoting platform staff). Deliberately NOT company-scoped and NOT a
 * TENANT_SCOPED_MODEL. Same append-only accountability discipline as
 * AuditLog: actorUserId is a plain string field, not a relation, so
 * deleting a User account never cascades into rewriting history;
 * prisma/grants.sql revokes UPDATE/DELETE on it the same way.
 */
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetEmail String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}

// ---------------------------------------------------------------------------
// Catalog & locations (Phase 1)
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku         String
  // Distinct from sku — the manufacturer/retail barcode (EAN-13, UPC-A,
  // etc.) printed on the physical product, scanned via the mobile app for
  // POS-speed sale entry and stock counts. Optional: a company assigns
  // its own SKU to every product regardless, but not every product comes
  // with a printed barcode (or a company may not bother recording one).
  barcode     String?
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  // Null = no low-stock alert configured for this product. Compared
  // against total stock across every location (warehouses + branches
  // summed), not per-location — a single number an owner can reason
  // about, not a per-location matrix to maintain.
  reorderPoint Int?

  // Opt-in per product — most goods aren't perishable and shouldn't pay
  // for batch bookkeeping they don't need. When true, external-delivery
  // receipts for this product require batch/expiry details, and sales
  // decrementing this product's branch stock auto-consume batches
  // FEFO (first-expiring-first-out) via decrementBranchStock() — see
  // inventory-service.ts for why that's the one place this could live
  // without touching every call site.
  tracksBatches Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  warehouseStocks WarehouseStock[]
  branchStocks    BranchStock[]
  stockTransfers  StockTransfer[]
  stockMovements  StockMovement[]
  saleLineItems   SaleLineItem[]
  batches         ProductBatch[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, isActive])
}

model Warehouse {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stocks            WarehouseStock[]
  outgoingTransfers StockTransfer[]  @relation("StockTransferSourceWarehouse")
  stockMovements    StockMovement[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stocks            BranchStock[]
  incomingTransfers StockTransfer[] @relation("StockTransferDestinationBranch")
  outgoingTransfers StockTransfer[] @relation("StockTransferSourceBranch")
  stockMovements    StockMovement[]
  sales             Sale[]
  expenses          Expense[]
  productBatches    ProductBatch[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

// Current quantity of a product at a warehouse — a cached projection kept
// in sync by the inventory service. Modeled as its own table (rather than a
// single polymorphic StockLevel with a nullable warehouseId/branchId) so its
// uniqueness constraint is airtight: Postgres treats NULL as distinct from
// NULL, so a shared nullable-FK table could silently admit duplicate rows.
model WarehouseStock {
  id          String    @id @default(cuid())
  companyId   String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, productId, warehouseId])
  @@index([companyId, warehouseId])
}

// Current quantity of a product at a branch — see WarehouseStock for why
// this is a separate table rather than a polymorphic one.
model BranchStock {
  id        String   @id @default(cuid())
  companyId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([companyId, productId, branchId])
  @@index([companyId, branchId])
}

// ---------------------------------------------------------------------------
// Stock transfers (Phase 2) — the accountability chain for moving stock
// from a warehouse to a branch, or receiving it directly from an external
// supplier at a branch.
// ---------------------------------------------------------------------------

enum StockTransferSourceType {
  WAREHOUSE
  BRANCH
  EXTERNAL
}

enum StockTransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  sourceType          StockTransferSourceType
  sourceWarehouseId   String?
  sourceWarehouse     Warehouse?              @relation("StockTransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  sourceBranchId      String?
  sourceBranch        Branch?                 @relation("StockTransferSourceBranch", fields: [sourceBranchId], references: [id])
  externalSourceName  String?
  destinationBranchId String
  destinationBranch   Branch                  @relation("StockTransferDestinationBranch", fields: [destinationBranchId], references: [id])

  status StockTransferStatus @default(REQUESTED)

  requestedByMembershipId String
  requestedAt             DateTime @default(now())

  approvedByMembershipId String?
  approvedAt             DateTime?

  rejectedByMembershipId String?
  rejectedAt             DateTime?
  rejectionReason        String?

  dispatchedByMembershipId String?
  dispatchedAt             DateTime?

  // Exactly which source ProductBatch row(s) (and how much of each) got
  // FEFO-consumed for this transfer, captured at the moment of decrement
  // (dispatch, or the inline decrement of an APPROVED transfer received
  // without a separate dispatch step) — same { batchId, batchNumber,
  // expiryDate, quantity } shape as SaleLineItem.batchConsumption. Only
  // ever set for a branch-sourced transfer of a batch-tracked product;
  // replayed at receipt to recreate the same batch identity at the
  // destination branch, so expiry tracking survives the move instead of
  // silently disappearing. Null for warehouse-sourced/external transfers
  // or non-batch-tracked products.
  dispatchedBatches Json?

  receivedByMembershipId String?
  receivedAt             DateTime?
  receivedQuantity       Int?

  cancelledByMembershipId String?
  cancelledAt             DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@index([companyId, status])
  @@index([companyId, productId])
  @@index([companyId, destinationBranchId])
  @@index([companyId, sourceWarehouseId])
  @@index([companyId, sourceBranchId])
}

enum StockMovementLocationType {
  WAREHOUSE
  BRANCH
}

enum StockMovementReason {
  TRANSFER_IN
  TRANSFER_OUT
  EXTERNAL_RECEIPT
  SALE
  SALE_VOID_RESTOCK
  ADJUSTMENT
  INITIAL_STOCK
}

// Immutable, append-only ledger of every stock quantity change, ever. This
// is the ground truth for reconciliation and audit — StockLevel tables
// (WarehouseStock/BranchStock) are a cached projection that must always sum
// to the same totals as this ledger. Never updated or deleted, so the app's
// Postgres role has UPDATE/DELETE revoked on this table (see Phase 7).
model StockMovement {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  locationType StockMovementLocationType
  warehouseId  String?
  warehouse    Warehouse?                @relation(fields: [warehouseId], references: [id])
  branchId     String?
  branch       Branch?                   @relation(fields: [branchId], references: [id])

  quantityDelta Int
  reason        StockMovementReason

  referenceType   String
  referenceId     String
  stockTransferId String?
  stockTransfer   StockTransfer? @relation(fields: [stockTransferId], references: [id])

  performedByMembershipId String
  createdAt               DateTime @default(now())

  @@index([companyId, productId, locationType])
  @@index([companyId, createdAt])
  @@index([companyId, referenceType, referenceId])
}

// ---------------------------------------------------------------------------
// Batch/lot tracking for perishables — opt-in per product
// (Product.tracksBatches). A batch is created wherever stock for a
// batch-tracked product actually enters the system (today: external
// delivery straight to a branch — see receiveExternalStock() — the most
// common "goods arrive" moment for the kind of small/medium perishables
// business this is aimed at, e.g. yogurt or juice arriving at a shop).
// quantityRemaining is kept honest by decrementBranchStock(): for a
// batch-tracked product it auto-consumes the soonest-expiring batches
// first (FEFO) as part of the exact same atomic decrement every sale
// already goes through — not a second, easy-to-forget bookkeeping step.
//
// branchId is a required, non-nullable column (not the nullable
// locationType/warehouseId/branchId union StockMovement uses) — Postgres
// treats NULL as distinct from NULL in unique constraints, so a nullable
// pair here would silently defeat @@unique's protection against a
// duplicate batch number the exact same way a single polymorphic
// WarehouseStock/BranchStock table would have (see that model's own
// comment). Warehouse-side batches aren't created anywhere yet — a
// known, scoped limitation, not a bug: most small businesses buying
// perishables receive them directly at the branch that sells them, not
// via an internal warehouse hop. Add a parallel WarehouseBatch model
// (not a nullable column here) if that's ever needed.
// ---------------------------------------------------------------------------

model ProductBatch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])

  batchNumber     String
  manufactureDate DateTime?
  expiryDate      DateTime

  quantityReceived  Int
  quantityRemaining Int

  receivedByMembershipId String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([companyId, productId, branchId, batchNumber])
  @@index([companyId, productId])
  @@index([companyId, expiryDate])
  @@index([companyId, branchId])
}

// ---------------------------------------------------------------------------
// Customers & debt management (Phase 8) — a registered customer that Sales
// can be linked to, so a business can see who owes them money across every
// sale rather than only per-invoice. Outstanding balance is never stored
// directly; it's always derived from Sale.grandTotal - Sale.amountPaid
// (the same ground truth the sale detail page already uses), so it can
// never drift out of sync with the payment ledger.
// ---------------------------------------------------------------------------

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  creditLimit Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  // Per-customer opt-out from automated debt reminders, independent of
  // the company-wide debtReminderEnabled switch — both must be true for a
  // reminder to actually send.
  remindersEnabled Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales         Sale[]
  debtReminders DebtReminder[]

  @@index([companyId, isActive])
  @@index([companyId, name])
}

enum DebtReminderChannel {
  SMS
}

enum DebtReminderStatus {
  SENT
  FAILED
}

// Append-only log of every reminder attempt — never updated or deleted,
// same accountability pattern as AuditLog/StockMovement, so "did we
// actually message this customer, and what did we say" is always
// answerable, and so the cooldown check (don't re-remind too often) has
// ground truth to read from.
model DebtReminder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  channel             DebtReminderChannel @default(SMS)
  message             String
  outstandingSnapshot Decimal             @db.Decimal(12, 2)
  status              DebtReminderStatus
  providerResponse    Json?
  error               String?

  triggeredByMembershipId String?

  createdAt DateTime @default(now())

  @@index([companyId, customerId, createdAt])
  @@index([companyId, createdAt])
}

// ---------------------------------------------------------------------------
// Expense management (Phase 9) — company-defined categories (the same
// business can track "Rent"/"Salaries"/"Restocking" or whatever fits how
// they operate) and the expense records themselves. Never hard-deleted —
// a correction is a documented void (voidedByMembershipId/voidedAt/
// voidReason), same accountability pattern as voiding a Sale, so the
// expense ledger can't silently lose history the way a DELETE would.
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

enum ExpenseRecurrenceInterval {
  WEEKLY
  MONTHLY
  YEARLY
}

model Expense {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  // Null = a company-wide expense (e.g. head-office rent) rather than tied
  // to one branch's operations.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  description String?

  // A label for reporting/filtering, not a scheduler — this phase does not
  // auto-generate future expense rows from a recurring one (that would
  // need a scheduled job, which nothing in this codebase runs yet).
  isRecurring        Boolean                    @default(false)
  recurrenceInterval ExpenseRecurrenceInterval?

  recordedByMembershipId String

  voidedByMembershipId String?
  voidedAt             DateTime?
  voidReason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, expenseDate])
  @@index([companyId, categoryId])
  @@index([companyId, branchId])
}

// ---------------------------------------------------------------------------
// Sales & payments (Phase 3)
// ---------------------------------------------------------------------------

enum SaleStatus {
  CONFIRMED
  PARTIALLY_PAID
  PAID
  VOIDED
}

model Sale {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])

  // Human-friendly sequential number (INV-000123), assigned from
  // Company.saleCounter incremented atomically in the same transaction as
  // the Sale insert, so two concurrent sales can never collide on it.
  saleNumber String

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?
  customerEmail String?
  dueDate       DateTime?

  status SaleStatus @default(CONFIRMED)

  // Always server-computed from line items — never trusted from the client,
  // even though the client also displays a running total for UX.
  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)
  amountPaid    Decimal @default(0) @db.Decimal(12, 2)

  soldByMembershipId String

  voidedByMembershipId String?
  voidedAt             DateTime?
  voidReason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems   SaleLineItem[]
  payments    Payment[]
  creditNotes CreditNote[]

  @@unique([companyId, saleNumber])
  @@index([companyId, branchId])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

// Line items are never edited after creation and a Sale is never deleted —
// unitPriceAtSale is a snapshot so a later change to Product.unitPrice can
// never rewrite a historical invoice's total.
model SaleLineItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity        Int
  unitPriceAtSale Decimal @db.Decimal(12, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  // Exactly which ProductBatch row(s) (and how much of each) this line
  // item's sale FEFO-consumed, for a batch-tracked product — an array of
  // { batchId, batchNumber, expiryDate, quantity }. Null for a
  // non-batch-tracked product. Recorded so voidSale() can restore the
  // precise batch(es) this sale took from, instead of guessing.
  batchConsumption Json?

  @@index([saleId])
  @@index([productId])
}

enum PaymentMode {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

// Multiple rows per Sale = the partial/installment payment ledger. Never
// updated or deleted — a correction is a documented void, not an edit.
model Payment {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])

  amount    Decimal     @db.Decimal(12, 2)
  mode      PaymentMode
  reference String?
  notes     String?

  recordedByMembershipId String
  paidAt                 DateTime @default(now())

  @@index([companyId, saleId])
  @@index([companyId, paidAt])
}

enum CreditNoteStatus {
  ISSUED
  VOIDED
}

// A formal financial correction against a Sale — a refund, price
// adjustment, or goodwill credit that reduces what the customer owes
// without voiding the original sale or its inventory impact (voiding a
// sale is a separate, existing action for "this sale should never have
// happened at all"; a credit note is for "the customer owes less than
// the original total for some other reason"). Deliberately does NOT
// touch stock — a credit note is a financial document, not a returns/
// restocking flow, which would need its own explicit design. Never
// hard-deleted — correcting one issued in error is a documented void,
// same pattern as voiding a Sale.
model CreditNote {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  // Human-friendly sequential number (CN-000123), assigned from
  // Company.creditNoteCounter incremented atomically in the same
  // transaction as the CreditNote insert — same collision-safety
  // pattern as Sale.saleNumber.
  creditNoteNumber String

  amount Decimal @db.Decimal(12, 2)
  reason String

  status CreditNoteStatus @default(ISSUED)

  issuedByMembershipId String

  voidedByMembershipId String?
  voidedAt             DateTime?
  voidReason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, creditNoteNumber])
  @@index([companyId, saleId])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Branding / theming (Phase 5)
// ---------------------------------------------------------------------------

enum LayoutPreset {
  DEFAULT
  COMPACT
}

model BrandingSettings {
  id             String       @id @default(cuid())
  companyId      String       @unique
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryColor   String       @default("#171717")
  secondaryColor String?
  logoUrl        String?
  layoutPreset   LayoutPreset @default(DEFAULT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Subscription billing (Phase 6)
// ---------------------------------------------------------------------------

enum PaystackEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// Platform-level, not tenant-scoped (a webhook arrives before we can
// necessarily resolve which company it belongs to). Stores every raw
// webhook payload keyed by Paystack's own event id, so a retried delivery
// is a no-op rather than double-applying a state change — Paystack (like
// most webhook providers) retries on anything other than a fast 2xx, so
// idempotency here isn't optional.
model PaystackEvent {
  id              String              @id @default(cuid())
  paystackEventId String              @unique
  eventType       String
  payload         Json
  status          PaystackEventStatus @default(RECEIVED)
  processedAt     DateTime?
  error           String?
  createdAt       DateTime            @default(now())

  @@index([eventType])
}
