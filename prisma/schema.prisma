// Prisma schema — tenancy/identity/RBAC (Phase 0) + catalog & stock (Phase 1)
// + stock transfers (Phase 2) + sales & payments (Phase 3). Later phases
// per the build roadmap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

// A company's business-verification (CAC) lifecycle — independent of
// CompanyStatus/billing. UNVERIFIED is the only state a company can be
// suspended-for-security in without also being locked out of the app (see
// the "soft reminder" design: the 5-day deadline never blocks access on
// its own, it just makes a company visible/filterable to platform staff).
enum CompanyVerificationStatus {
  UNVERIFIED // default; nothing submitted yet, or the deadline has passed with nothing submitted
  PENDING_REVIEW // certificate submitted, awaiting a platform admin's decision
  VERIFIED // reviewed and approved — shows a verified badge
  REJECTED // reviewed and rejected; the company can resubmit
  APPROVED_WITHOUT_CAC // no CAC certificate exists (e.g. not yet incorporated), but a platform admin manually approved the company to operate anyway
}

model Company {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  status            CompanyStatus @default(TRIAL)
  currency          String        @default("NGN")
  timezone          String        @default("Africa/Lagos")
  saleCounter       Int           @default(0)
  creditNoteCounter Int           @default(0)
  poCounter         Int           @default(0)
  walkInCounter     Int           @default(0)

  // What kind of business this is, gathered at Owner sign-up (a curated
  // list in the UI, but stored as free text so a custom "Other" entry
  // doesn't need a schema change). Not required to be one of the UI's
  // suggested options.
  businessType String?

  // The code a staff member types at self-service sign-up to request to
  // join this company (see staff-signup-service.ts) — always present and
  // globally unique, set once at company creation and never changed.
  // Distinct from rcNumber below: this is normalized from rcNumber if one
  // was given at sign-up, or app-generated otherwise, and it doesn't
  // change even if the company later corrects/resubmits a different
  // rcNumber for CAC verification.
  companyCode String @unique

  // Off by default — sending automated messages to a company's customers
  // is a consent-adjacent action that shouldn't silently turn on for an
  // existing company just because this feature shipped.
  debtReminderEnabled     Boolean @default(false)
  debtReminderDaysOverdue Int     @default(7)

  // Consumed one-per-send in sendDebtReminders(); replenished monthly by
  // the subscription's Plan.features.includedReminderCredits (see
  // plan-features.ts) and top-uppable via a one-time Paystack purchase
  // (billing-service.ts). Balance, not a ledger table — DebtReminder rows
  // and AuditLog "billing.reminder_credits_purchased" entries already give
  // a reconstructable history without a dedicated transactions table.
  reminderCreditBalance      Int       @default(0)
  reminderCreditsRefreshedAt DateTime?

  // Business verification (CAC). rcNumber/incorporationDate are collected
  // (optionally) at sign-up; verificationDeadline is set to createdAt + 5
  // days there too. A company with no CAC is still allowed to operate —
  // reaching the deadline with nothing submitted never blocks access on
  // its own, it only makes the company show up as overdue for a platform
  // admin to chase up or explicitly approve without one.
  rcNumber                     String?
  incorporationDate            DateTime?
  verificationStatus           CompanyVerificationStatus @default(UNVERIFIED)
  verificationDeadline         DateTime?
  cacCertificateUrl            String?
  cacSubmittedAt               DateTime?
  // Reviewer is a platform User.id (SUPER_ADMIN), stored the same
  // no-FK-relation way PlatformAuditLog.actorUserId is — platform staff
  // aren't Membership rows, so there's no scoped relation to hang off of.
  verificationReviewedAt       DateTime?
  verificationReviewedByUserId String?
  verificationNote             String? // rejection reason, or an approval note

  // Security kill switch a SUPER_ADMIN can flip independent of billing —
  // sets status to SUSPENDED (blocking the whole company, see
  // getCurrentMembership()) and remembers the prior status so re-enabling
  // restores it exactly rather than guessing ACTIVE vs TRIAL.
  statusBeforeSuspension CompanyStatus?
  disabledAt             DateTime?
  disabledByUserId       String?
  disabledReason         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships       Membership[]
  roles             Role[]
  invitations       Invitation[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  products          Product[]
  warehouses        Warehouse[]
  branches          Branch[]
  stockTransfers    StockTransfer[]
  stockMovements    StockMovement[]
  sales             Sale[]
  payments          Payment[]
  brandingSettings  BrandingSettings?
  customers         Customer[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  debtReminders     DebtReminder[]
  reminderTemplates DebtReminderTemplate[]
  creditNotes       CreditNote[]
  productBatches    ProductBatch[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  dailySalesReports DailySalesReport[]
  reminderCreditPurchases ReminderCreditPurchase[]
  saleFlags         SaleFlag[]
  notifications     Notification[]

  @@index([status])
  @@index([verificationStatus])
}

/**
 * One row per completed reminder-credit top-up — doubles as the audit
 * trail for "where did this balance come from" and the idempotency guard
 * against double-crediting the same Paystack transaction (the redirect
 * callback and the webhook both try to apply it; `reference` is unique so
 * whichever arrives second just no-ops against the first's row).
 */
model ReminderCreditPurchase {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference String   @unique
  credits   Int
  priceKobo Int
  createdAt DateTime @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Better Auth core tables (managed by the Better Auth Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Platform-level, not company-level — deliberately NOT a Membership/Role
  // grant, since those are always scoped to one Company by getScopedPrisma.
  // Someone with a platform role has no company at all; requireSuperAdmin()/
  // requirePlatformStaff() (src/lib/auth/session.ts) check this directly
  // against the raw `prisma` singleton, bypassing tenant scoping entirely
  // on purpose for the one narrow /admin surface that legitimately needs
  // to see across every company. SUPER_ADMIN can see every company
  // (view-only) and manage the SUPPORT_AGENT roster; SUPPORT_AGENT can
  // also see every company (same view-only data) and generate password
  // reset links for locked-out users, but cannot grant platform access to
  // anyone else. Null means "not platform staff" — an ordinary user.
  platformRole PlatformRole?

  // Managed entirely by Better Auth's two-factor plugin — flips true only
  // after enrollment is confirmed with a valid TOTP code (see
  // TwoFactor.verified below), never just on "enable" being called.
  // Mandatory for company Owners and platform staff (SUPER_ADMIN/
  // SUPPORT_AGENT); optional for everyone else — see
  // requireMembershipWithTwoFactor()/requirePlatformStaffWithTwoFactor()
  // in src/lib/auth/session.ts for where that's enforced.
  twoFactorEnabled Boolean @default(false)

  // Null = no personal override — falls back to the signed-in company's
  // BrandingSettings.defaultTheme (see src/lib/theme.ts's resolveTheme),
  // then to DARK globally. Set the moment someone flips the ThemeToggle
  // while signed in, so their choice follows them across devices; an
  // anonymous visitor's toggle only ever touches the `theme` cookie.
  theme Theme?

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  twoFactors  TwoFactor[]

  @@map("user")
}

// Shared by User.theme (personal override) and BrandingSettings.defaultTheme
// (company-wide default) — see src/lib/theme.ts for the resolution order.
enum Theme {
  LIGHT
  DARK
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_AGENT
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  // Added when better-auth was bumped to ^1.7.1 to pull in @better-auth/expo
  // for mobile auth — the Prisma adapter now requires this column (paired
  // with accountId in a unique index) to distinguish which credential
  // issuer an account row came from (e.g. "local:credential" for
  // email/password vs. an OAuth provider's issuer URL).
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Staff / RBAC
// ---------------------------------------------------------------------------

enum MembershipStatus {
  INVITED
  // A staff member who self-signed-up with the company's join code (see
  // staff-signup-service.ts) rather than being invited by an Owner —
  // awaiting Owner approval and a role assignment before becoming ACTIVE.
  // Distinct from INVITED (Owner-initiated, currently unused — see
  // plan-limit-service.ts) since the direction of initiation matters for
  // anyone reading a membership's history.
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

// A Membership is a User acting as staff within one Company. This is the
// entity referenced everywhere else in the app ("who requested this
// transfer", "who recorded this sale") instead of User directly, so
// permissions and identity are always tenant-scoped.

model Membership {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String?
  role        Role?            @relation(fields: [roleId], references: [id])
  status      MembershipStatus @default(ACTIVE)
  displayName String?
  jobTitle    String?

  invitedByMembershipId String?
  invitedAt             DateTime?
  joinedAt              DateTime?

  // Self-service, set/changed by the staff member themselves from the
  // mobile app (never by an Owner) — a fast local re-auth gate for
  // switching between staff already fully signed in on one shared shop
  // phone. Scrypt-hashed ("salt:hash" hex), never the raw PIN. This is
  // NOT a standalone credential: it only ever gates reactivating a
  // session that a real email/password (+2FA, if applicable) login
  // already established on that device — see mobile/lib/device-profiles.ts.
  devicePinHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissionOverrides MembershipPermissionOverride[]

  @@unique([userId, companyId])
  @@index([companyId, status])
}

// Per-company role templates (a bundle of default permissions).

model Role {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([companyId, name])
}

// Fixed, code-defined permission catalog — seeded, not company-editable.
// Kept in sync with src/lib/auth/permissions.ts (PERMISSIONS catalog).

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  category    String
  description String

  rolePermissions     RolePermission[]
  membershipOverrides MembershipPermissionOverride[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

enum PermissionEffect {
  GRANT
  DENY
}

// Per-staff, admin-modifiable grant/deny on top of the staff member's role.
// Effective permission = (role's permissions ∪ GRANT overrides) − DENY overrides.

model MembershipPermissionOverride {
  id                    String           @id @default(cuid())
  membershipId          String
  membership            Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permissionId          String
  permission            Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect                PermissionEffect
  grantedByMembershipId String
  reason                String?
  createdAt             DateTime         @default(now())

  @@unique([membershipId, permissionId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id                    String           @id @default(cuid())
  companyId             String
  company               Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email                 String
  roleId                String
  role                  Role             @relation(fields: [roleId], references: [id])
  invitedByMembershipId String
  tokenHash             String           @unique
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime
  createdAt             DateTime         @default(now())

  @@index([companyId, email])
}

// ---------------------------------------------------------------------------
// Billing skeleton (full Paystack wiring lands in Phase 6)
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTHLY
}

model Plan {
  id               String          @id @default(cuid())
  name             String          @unique
  paystackPlanCode String?         @unique
  priceKobo        Int
  billingInterval  BillingInterval @default(MONTHLY)
  features         Json
  isActive         Boolean         @default(true)

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

model Subscription {
  id                       String             @id @default(cuid())
  companyId                String             @unique
  company                  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId                   String
  plan                     Plan               @relation(fields: [planId], references: [id])
  paystackSubscriptionCode String?
  paystackCustomerCode     String?
  status                   SubscriptionStatus @default(TRIALING)
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  trialEndsAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log (security backbone — append-only)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
}

model AuditLog {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorMembershipId String?
  actorType         AuditActorType @default(USER)
  action            String
  entityType        String
  entityId          String
  metadata          Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime       @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, action])
}

/**
 * The platform-level counterpart to AuditLog — for actions taken by
 * SUPER_ADMIN/SUPPORT_AGENT users that don't belong to any one company
 * (generating a password reset link for a locked-out user, promoting or
 * demoting platform staff). Deliberately NOT company-scoped and NOT a
 * TENANT_SCOPED_MODEL. Same append-only accountability discipline as
 * AuditLog: actorUserId is a plain string field, not a relation, so
 * deleting a User account never cascades into rewriting history;
 * prisma/grants.sql revokes UPDATE/DELETE on it the same way.
 */
model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetEmail String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}

// ---------------------------------------------------------------------------
// Catalog & locations (Phase 1)
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku         String
  // Distinct from sku — the manufacturer/retail barcode (EAN-13, UPC-A,
  // etc.) printed on the physical product, scanned via the mobile app for
  // POS-speed sale entry and stock counts. Optional: a company assigns
  // its own SKU to every product regardless, but not every product comes
  // with a printed barcode (or a company may not bother recording one).
  barcode     String?
  name        String
  description String?
  // Free-text, merchant-chosen ("carton", "bag", "dozen", "mudu", "yard")
  // rather than a fixed enum — informal-market goods aren't sold in
  // generic "units," and forcing a fixed list would mean missing whatever
  // a given trade actually uses. Shown next to every quantity in the UI;
  // purely cosmetic, never affects stock math (still tracked as a plain
  // integer count of this unit).
  unitLabel   String   @default("unit")
  unitPrice   Decimal  @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  // Null = no low-stock alert configured for this product. Compared
  // against total stock across every location (warehouses + branches
  // summed), not per-location — a single number an owner can reason
  // about, not a per-location matrix to maintain.
  reorderPoint Int?

  // Opt-in per product — most goods aren't perishable and shouldn't pay
  // for batch bookkeeping they don't need. When true, external-delivery
  // receipts for this product require batch/expiry details, and sales
  // decrementing this product's branch stock auto-consume batches
  // FEFO (first-expiring-first-out) via decrementBranchStock() — see
  // inventory-service.ts for why that's the one place this could live
  // without touching every call site.
  tracksBatches Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  warehouseStocks WarehouseStock[]
  branchStocks    BranchStock[]
  stockTransfers  StockTransfer[]
  stockMovements  StockMovement[]
  saleLineItems   SaleLineItem[]
  batches         ProductBatch[]
  purchaseOrderLineItems PurchaseOrderLineItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, isActive])
}

model Warehouse {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stocks                    WarehouseStock[]
  outgoingTransfers         StockTransfer[]  @relation("StockTransferSourceWarehouse")
  incomingExternalTransfers StockTransfer[]  @relation("StockTransferDestinationWarehouse")
  stockMovements            StockMovement[]
  productBatches            ProductBatch[]
  purchaseOrders            PurchaseOrder[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stocks            BranchStock[]
  incomingTransfers StockTransfer[] @relation("StockTransferDestinationBranch")
  outgoingTransfers StockTransfer[] @relation("StockTransferSourceBranch")
  stockMovements    StockMovement[]
  sales             Sale[]
  expenses          Expense[]
  productBatches    ProductBatch[]
  purchaseOrders    PurchaseOrder[]
  dailySalesReports DailySalesReport[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

// Current quantity of a product at a warehouse — a cached projection kept
// in sync by the inventory service. Modeled as its own table (rather than a
// single polymorphic StockLevel with a nullable warehouseId/branchId) so its
// uniqueness constraint is airtight: Postgres treats NULL as distinct from
// NULL, so a shared nullable-FK table could silently admit duplicate rows.
model WarehouseStock {
  id          String    @id @default(cuid())
  companyId   String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, productId, warehouseId])
  @@index([companyId, warehouseId])
}

// Current quantity of a product at a branch — see WarehouseStock for why
// this is a separate table rather than a polymorphic one.
model BranchStock {
  id        String   @id @default(cuid())
  companyId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([companyId, productId, branchId])
  @@index([companyId, branchId])
}

// ---------------------------------------------------------------------------
// Stock transfers (Phase 2) — the accountability chain for moving stock
// from a warehouse to a branch, or receiving it directly from an external
// supplier at a branch.
// ---------------------------------------------------------------------------

enum StockTransferSourceType {
  WAREHOUSE
  BRANCH
  EXTERNAL
}

enum StockTransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  // Null while REQUESTED — the requester no longer picks a source; the
  // reviewer chooses it (warehouse, another branch, or an external
  // supplier) at approval time, via approveTransfer's resolution.
  sourceType         StockTransferSourceType?
  sourceWarehouseId  String?
  sourceWarehouse    Warehouse?              @relation("StockTransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  sourceBranchId     String?
  sourceBranch       Branch?                 @relation("StockTransferSourceBranch", fields: [sourceBranchId], references: [id])
  externalSourceName String?

  // Exactly one of these is set (enforced by a CHECK constraint added
  // directly in the migration) — the internal request/approve/dispatch/
  // receive flow always targets a branch (a warehouse only ever *supplies*
  // an internal transfer, never receives one), but an EXTERNAL delivery
  // can now land straight at a warehouse instead of a branch, for
  // perishables that commonly wait there before reaching one.
  destinationBranchId    String?
  destinationBranch      Branch?    @relation("StockTransferDestinationBranch", fields: [destinationBranchId], references: [id])
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("StockTransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id])

  status StockTransferStatus @default(REQUESTED)

  requestedByMembershipId String
  requestedAt             DateTime @default(now())

  approvedByMembershipId String?
  approvedAt             DateTime?

  rejectedByMembershipId String?
  rejectedAt             DateTime?
  rejectionReason        String?

  dispatchedByMembershipId String?
  dispatchedAt             DateTime?

  // Exactly which source ProductBatch row(s) (and how much of each) got
  // FEFO-consumed for this transfer, captured at the moment of decrement
  // (dispatch, or the inline decrement of an APPROVED transfer received
  // without a separate dispatch step) — same { batchId, batchNumber,
  // expiryDate, quantity } shape as SaleLineItem.batchConsumption. Set for
  // a branch- OR warehouse-sourced transfer of a batch-tracked product
  // (both locations track batches); replayed at receipt to recreate the
  // same batch identity at the destination branch, so expiry tracking
  // survives the move instead of silently disappearing. Null for an
  // external transfer or a non-batch-tracked product, or when the source
  // location had no matching batch rows to consume from (e.g. batch
  // tracking was turned on after stock already existed there).
  dispatchedBatches Json?

  receivedByMembershipId String?
  receivedAt             DateTime?
  receivedQuantity       Int?

  cancelledByMembershipId String?
  cancelledAt             DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@index([companyId, status])
  @@index([companyId, productId])
  @@index([companyId, destinationBranchId])
  @@index([companyId, sourceWarehouseId])
  @@index([companyId, sourceBranchId])
}

enum StockMovementLocationType {
  WAREHOUSE
  BRANCH
}

enum StockMovementReason {
  TRANSFER_IN
  TRANSFER_OUT
  EXTERNAL_RECEIPT
  SALE
  SALE_VOID_RESTOCK
  ADJUSTMENT
  INITIAL_STOCK
  PURCHASE_RECEIPT
}

// Immutable, append-only ledger of every stock quantity change, ever. This
// is the ground truth for reconciliation and audit — StockLevel tables
// (WarehouseStock/BranchStock) are a cached projection that must always sum
// to the same totals as this ledger. Never updated or deleted, so the app's
// Postgres role has UPDATE/DELETE revoked on this table (see Phase 7).
model StockMovement {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  locationType StockMovementLocationType
  warehouseId  String?
  warehouse    Warehouse?                @relation(fields: [warehouseId], references: [id])
  branchId     String?
  branch       Branch?                   @relation(fields: [branchId], references: [id])

  quantityDelta Int
  reason        StockMovementReason

  referenceType   String
  referenceId     String
  stockTransferId String?
  stockTransfer   StockTransfer? @relation(fields: [stockTransferId], references: [id])

  performedByMembershipId String
  createdAt               DateTime @default(now())

  @@index([companyId, productId, locationType])
  @@index([companyId, createdAt])
  @@index([companyId, referenceType, referenceId])
}

// ---------------------------------------------------------------------------
// Batch/lot tracking for perishables — opt-in per product
// (Product.tracksBatches). A batch is created wherever stock for a
// batch-tracked product actually enters the system (today: external
// delivery straight to a branch — see receiveExternalStock() — the most
// common "goods arrive" moment for the kind of small/medium perishables
// business this is aimed at, e.g. yogurt or juice arriving at a shop).
// quantityRemaining is kept honest by decrementBranchStock(): for a
// batch-tracked product it auto-consumes the soonest-expiring batches
// first (FEFO) as part of the exact same atomic decrement every sale
// already goes through — not a second, easy-to-forget bookkeeping step.
//
// branchId is a required, non-nullable column (not the nullable
// locationType/warehouseId/branchId union StockMovement uses) — Postgres
// treats NULL as distinct from NULL in unique constraints, so a nullable
// pair here would silently defeat @@unique's protection against a
// duplicate batch number the exact same way a single polymorphic
// WarehouseStock/BranchStock table would have (see that model's own
// comment). Warehouse-side batches aren't created anywhere yet — a
// known, scoped limitation, not a bug: most small businesses buying
// perishables receive them directly at the branch that sells them, not
// via an internal warehouse hop. Add a parallel WarehouseBatch model
// (not a nullable column here) if that's ever needed.
// ---------------------------------------------------------------------------

model ProductBatch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Exactly one of these is set — a batch lives at a branch OR a
  // warehouse, never both, never neither (enforced by a CHECK constraint
  // added directly in the migration; Prisma's schema language has no
  // syntax for one). Warehouses gained batch tracking so a perishable
  // sitting there before reaching a branch isn't an expiry blind spot —
  // decrementWarehouseStock/decrementBranchStock (inventory-service.ts)
  // both FEFO-consume from whichever location they're given, and a
  // warehouse-sourced transfer now carries its batch identity forward to
  // the receiving branch the same way a branch-sourced one already did.
  branchId    String?
  branch      Branch?    @relation(fields: [branchId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  batchNumber     String
  manufactureDate DateTime?
  expiryDate      DateTime

  quantityReceived  Int
  quantityRemaining Int

  receivedByMembershipId String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([companyId, productId, branchId, batchNumber])
  @@unique([companyId, productId, warehouseId, batchNumber])
  @@index([companyId, productId])
  @@index([companyId, expiryDate])
  @@index([companyId, branchId])
  @@index([companyId, warehouseId])
}

// ---------------------------------------------------------------------------
// Purchase orders — the accountability chain for ordering stock from a
// supplier, mirroring StockTransfer's request/approve-esque discipline:
// a PO is a commitment record (DRAFT) that becomes a real order (ORDERED),
// then gets reconciled against what was actually delivered one line item at
// a time (PARTIALLY_RECEIVED/RECEIVED). Line items are fixed once ORDERED —
// same "no editing, only state transitions" design as StockTransfer.
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Human-friendly sequential number (PO-000123), assigned from
  // Company.poCounter incremented atomically in the same transaction as
  // the PurchaseOrder insert — same collision-safety pattern as
  // Sale.saleNumber/CreditNote.creditNoteNumber.
  poNumber   String
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Exactly one of these is set (enforced by a CHECK constraint added
  // directly in the migration, same pattern as StockTransfer's own
  // destination pair) — a PO's delivery lands at a branch or a warehouse,
  // never both, never neither.
  destinationBranchId    String?
  destinationBranch      Branch?    @relation(fields: [destinationBranchId], references: [id])
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation(fields: [destinationWarehouseId], references: [id])

  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String?

  createdByMembershipId String

  orderedByMembershipId String?
  orderedAt             DateTime?

  cancelledByMembershipId String?
  cancelledAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems PurchaseOrderLineItem[]

  @@unique([companyId, poNumber])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@index([companyId, destinationBranchId])
  @@index([companyId, destinationWarehouseId])
}

// Line items are fixed once the parent PO leaves DRAFT — no editing after
// ordering, same discipline as SaleLineItem's post-sale immutability.
model PurchaseOrderLineItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])

  quantityOrdered  Int
  unitCost         Decimal @db.Decimal(12, 2)
  quantityReceived Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Customers & debt management (Phase 8) — a registered customer that Sales
// can be linked to, so a business can see who owes them money across every
// sale rather than only per-invoice. Outstanding balance is never stored
// directly; it's always derived from Sale.grandTotal - Sale.amountPaid
// (the same ground truth the sale detail page already uses), so it can
// never drift out of sync with the payment ledger.
// ---------------------------------------------------------------------------

// A reusable debt-reminder wording a company can define and then assign
// per customer (Customer.reminderTemplateId) — e.g. a soft "Friendly
// nudge" for most customers and a firmer "Final notice" for repeat
// late-payers. `message` supports {name}/{company}/{amount}/{currency}/
// {pay_link} placeholders, substituted at send time by
// debt-reminder-service.ts's renderReminderMessage(). Exactly one template
// per company may have isDefault true at a time — enforced in
// debt-reminder-template-service.ts, not the database, since Prisma has no
// partial/filtered unique constraint; it's the fallback for any customer
// with no template of their own explicitly assigned.
model DebtReminderTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  message   String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  creditLimit Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  // Per-customer opt-out from automated debt reminders, independent of
  // the company-wide debtReminderEnabled switch — both must be true for a
  // reminder to actually send.
  remindersEnabled Boolean @default(true)

  // Which wording this customer's reminders use. Null falls back to the
  // company's default template (DebtReminderTemplate.isDefault), or — if
  // the company has no templates set up at all — the original hardcoded
  // message, so adopting templates is purely opt-in and never breaks an
  // existing company's reminders. SetNull (not Restrict) so deleting a
  // template a customer was assigned just falls them back to the default
  // rather than blocking the delete.
  reminderTemplateId String?
  reminderTemplate   DebtReminderTemplate? @relation(fields: [reminderTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales         Sale[]
  debtReminders DebtReminder[]

  @@index([companyId, isActive])
  @@index([companyId, name])
}

enum DebtReminderChannel {
  SMS
}

enum DebtReminderStatus {
  SENT
  FAILED
}

// Append-only log of every reminder attempt — never updated or deleted,
// same accountability pattern as AuditLog/StockMovement, so "did we
// actually message this customer, and what did we say" is always
// answerable, and so the cooldown check (don't re-remind too often) has
// ground truth to read from.
model DebtReminder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  channel             DebtReminderChannel @default(SMS)
  message             String
  outstandingSnapshot Decimal             @db.Decimal(12, 2)
  status              DebtReminderStatus
  providerResponse    Json?
  error               String?

  triggeredByMembershipId String?

  createdAt DateTime @default(now())

  @@index([companyId, customerId, createdAt])
  @@index([companyId, createdAt])
}

// ---------------------------------------------------------------------------
// Expense management (Phase 9) — company-defined categories (the same
// business can track "Rent"/"Salaries"/"Restocking" or whatever fits how
// they operate) and the expense records themselves. Never hard-deleted —
// a correction is a documented void (voidedByMembershipId/voidedAt/
// voidReason), same accountability pattern as voiding a Sale, so the
// expense ledger can't silently lose history the way a DELETE would.
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

enum ExpenseRecurrenceInterval {
  WEEKLY
  MONTHLY
  YEARLY
}

model Expense {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  // Null = a company-wide expense (e.g. head-office rent) rather than tied
  // to one branch's operations.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  description String?

  // A label for reporting/filtering, not a scheduler — this phase does not
  // auto-generate future expense rows from a recurring one (that would
  // need a scheduled job, which nothing in this codebase runs yet).
  isRecurring        Boolean                    @default(false)
  recurrenceInterval ExpenseRecurrenceInterval?

  recordedByMembershipId String

  voidedByMembershipId String?
  voidedAt             DateTime?
  voidReason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, expenseDate])
  @@index([companyId, categoryId])
  @@index([companyId, branchId])
}

// ---------------------------------------------------------------------------
// Sales & payments (Phase 3)
// ---------------------------------------------------------------------------

enum SaleStatus {
  CONFIRMED
  PARTIALLY_PAID
  PAID
  VOIDED
}

model Sale {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])

  // Human-friendly sequential number (INV-000123), assigned from
  // Company.saleCounter incremented atomically in the same transaction as
  // the Sale insert, so two concurrent sales can never collide on it.
  saleNumber String

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?
  customerEmail String?
  dueDate       DateTime?

  status SaleStatus @default(CONFIRMED)

  // Always server-computed from line items — never trusted from the client,
  // even though the client also displays a running total for UX.
  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @db.Decimal(12, 2)
  amountPaid    Decimal @default(0) @db.Decimal(12, 2)

  soldByMembershipId String

  voidedByMembershipId String?
  voidedAt             DateTime?
  voidReason           String?

  // Idempotency key set only by the mobile app's offline sync queue — a
  // sale created on web/normal online flows never sets this. Lets a retried
  // sync request (the server already created the Sale but the phone never
  // saw the response) return the existing Sale instead of creating a
  // duplicate and double-decrementing stock. Nullable + unique: Postgres
  // treats multiple NULLs as distinct, so ordinary sales never collide here.
  clientRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems   SaleLineItem[]
  payments    Payment[]
  creditNotes CreditNote[]
  flags       SaleFlag[]

  @@unique([companyId, saleNumber])
  @@unique([companyId, clientRequestId])
  @@index([companyId, branchId])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

enum SaleFlagStatus {
  FLAGGED
  RESOLVED
  ESCALATED
}

// A reviewer's after-the-fact rejection of a specific sale — the exception
// path, not a review gate every sale goes through. Deliberately a separate
// model rather than fields on Sale itself: a Sale's own lifecycle
// (SaleStatus) tracks payment progress and must stay untouched by this: a
// PAID sale can still get flagged (e.g. wrong customer info), and this
// records that fact + its resolution without disturbing the payment
// ledger.
//
// "Edit and resubmit" here is intentionally narrow — only the
// customer-identifying fields (name/phone/email/due date) on the Sale are
// corrected in place (see resolveSaleFlag in sale-flag-service.ts). Line
// items, quantities, and prices are never touched after the fact anywhere
// else in this app (they're immutable snapshots — see SaleLineItem's own
// comment), and correcting a wrong quantity/price/product is still what
// void + a fresh sale is for. This model only fixes the "who is this sale
// actually for" class of mistake a reviewer would flag.
model SaleFlag {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId    String
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status    SaleFlagStatus @default(FLAGGED)

  // Plain strings, no relation — same pattern as Sale.soldByMembershipId:
  // removing a Membership must never cascade into rewriting this history.
  flaggedByMembershipId String
  reason                String

  // Midnight (Company.timezone) of the day the flag was raised — the
  // resubmission deadline. Past this instant with status still FLAGGED,
  // the deadline-check cron (see /api/cron/sale-flag-deadlines) escalates
  // it: notifies Branch Manager + Owner, and opens resolve rights beyond
  // just the original submitter.
  deadline DateTime

  resolvedByMembershipId String?
  resolvedAt              DateTime?
  resolutionNote          String?

  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, saleId])
}

enum NotificationType {
  SALE_FLAGGED
  SALE_FLAG_ESCALATED
  SALE_FLAG_RESOLVED
  TRANSFER_DISCREPANCY
  LOW_STOCK
}

// In-app notification delivery — no email/SMS/push, just a bell + list in
// the web app. membershipId is a plain string (no relation), same
// removing-a-Membership-shouldn't-cascade reasoning as everywhere else a
// membership is merely referenced rather than owned.
model Notification {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membershipId String
  type         NotificationType
  title        String
  body         String
  entityType   String?
  entityId     String?
  readAt       DateTime?

  createdAt DateTime @default(now())

  @@index([companyId, membershipId, readAt])
}

// Line items are never edited after creation and a Sale is never deleted —
// unitPriceAtSale is a snapshot so a later change to Product.unitPrice can
// never rewrite a historical invoice's total.
model SaleLineItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Null for an ad-hoc service line (see isService/adHocDescription below)
  // — there's no catalog record for it, so nothing to point at.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // An ad-hoc service entry: staff type a free-text description + price
  // directly on the sale, with no Product record at all (unlike a normal
  // catalog item). isService is what the UI actually keys off of to show
  // the "Service" tag — it's independent of productId being null so a
  // catalog product could theoretically be tagged too, though today only
  // ad-hoc entries ever set it. adHocDescription holds the free-text
  // staff typed; unused (null) for a normal product line item.
  isService        Boolean @default(false)
  adHocDescription String?

  quantity        Int
  unitPriceAtSale Decimal @db.Decimal(12, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)

  // Exactly which ProductBatch row(s) (and how much of each) this line
  // item's sale FEFO-consumed, for a batch-tracked product — an array of
  // { batchId, batchNumber, expiryDate, quantity }. Null for a
  // non-batch-tracked product. Recorded so voidSale() can restore the
  // precise batch(es) this sale took from, instead of guessing.
  batchConsumption Json?

  @@index([saleId])
  @@index([productId])
}

enum PaymentMode {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  POS
  OTHER
}

// Multiple rows per Sale = the partial/installment payment ledger. Never
// updated or deleted — a correction is a documented void, not an edit.
model Payment {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])

  amount    Decimal     @db.Decimal(12, 2)
  mode      PaymentMode
  reference String?
  notes     String?

  // Null means this wasn't recorded by any staff member — a debtor paying
  // through their own self-serve payment link (see payment-link.ts) is the
  // one case that applies to; every other payment path still always
  // supplies a real membership.
  recordedByMembershipId String?
  paidAt                 DateTime @default(now())

  @@index([companyId, saleId])
  @@index([companyId, paidAt])
}

enum CreditNoteStatus {
  ISSUED
  VOIDED
}

// A formal financial correction against a Sale — a refund, price
// adjustment, or goodwill credit that reduces what the customer owes
// without voiding the original sale or its inventory impact (voiding a
// sale is a separate, existing action for "this sale should never have
// happened at all"; a credit note is for "the customer owes less than
// the original total for some other reason"). Deliberately does NOT
// touch stock — a credit note is a financial document, not a returns/
// restocking flow, which would need its own explicit design. Never
// hard-deleted — correcting one issued in error is a documented void,
// same pattern as voiding a Sale.
model CreditNote {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  // Human-friendly sequential number (CN-000123), assigned from
  // Company.creditNoteCounter incremented atomically in the same
  // transaction as the CreditNote insert — same collision-safety
  // pattern as Sale.saleNumber.
  creditNoteNumber String

  amount Decimal @db.Decimal(12, 2)
  reason String

  status CreditNoteStatus @default(ISSUED)

  issuedByMembershipId String

  voidedByMembershipId String?
  voidedAt             DateTime?
  voidReason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, creditNoteNumber])
  @@index([companyId, saleId])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Daily sales reports — end-of-day accountability. A staff member's sales at
// one branch, for one business day, get submitted for the Owner to approve,
// send back (with a note, reopening that day for corrections before
// resubmission), or reject. Not a DRAFT-first workflow — the row is created
// at submission time, computed fresh from real Sale/Payment data, never
// trusted from the client. See src/server/services/sales-report-service.ts.
// ---------------------------------------------------------------------------

enum SalesReportStatus {
  SUBMITTED
  APPROVED
  SENT_BACK
  REJECTED
}

model DailySalesReport {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])

  // Plain string, no relation — same pattern as Sale.soldByMembershipId /
  // StockTransfer.requestedByMembershipId — removing a Membership must never
  // cascade into rewriting a historical report.
  membershipId String
  // Normalized to that business day's midnight in Company.timezone (see
  // src/lib/business-day.ts) — Sale/Payment timestamps are UTC, but a
  // report buckets by the business's *local* day.
  reportDate DateTime

  status SalesReportStatus @default(SUBMITTED)

  salesCount        Int
  grossSalesTotal   Decimal  @db.Decimal(12, 2)
  discountTotal     Decimal  @db.Decimal(12, 2)
  paymentsCollected Decimal  @db.Decimal(12, 2)
  // The reconciliation ground truth: CASH-mode payments this staff recorded
  // today at this branch, summed server-side — never client-supplied.
  cashCollected   Decimal  @db.Decimal(12, 2)
  declaredCash    Decimal? @db.Decimal(12, 2)
  cashDiscrepancy Decimal? @db.Decimal(12, 2)

  staffNote String?
  ownerNote String?

  submittedAt             DateTime  @default(now())
  respondedByMembershipId String?
  respondedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, branchId, membershipId, reportDate])
  @@index([companyId, status])
  @@index([companyId, branchId, reportDate])
}

// ---------------------------------------------------------------------------
// Branding / theming (Phase 5)
// ---------------------------------------------------------------------------

enum LayoutPreset {
  DEFAULT
  COMPACT
}

model BrandingSettings {
  id             String       @id @default(cuid())
  companyId      String       @unique
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryColor   String       @default("#171717")
  secondaryColor String?
  logoUrl        String?
  layoutPreset   LayoutPreset @default(DEFAULT)
  // The theme a member of this company sees until they personally
  // override it (User.theme) — Owner-configurable, same "set the company
  // default, let individuals override" pattern as everything else here.
  defaultTheme   Theme        @default(DARK)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Subscription billing (Phase 6)
// ---------------------------------------------------------------------------

enum PaystackEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// Platform-level, not tenant-scoped (a webhook arrives before we can
// necessarily resolve which company it belongs to). Stores every raw
// webhook payload keyed by Paystack's own event id, so a retried delivery
// is a no-op rather than double-applying a state change — Paystack (like
// most webhook providers) retries on anything other than a fast 2xx, so
// idempotency here isn't optional.
model PaystackEvent {
  id              String              @id @default(cuid())
  paystackEventId String              @unique
  eventType       String
  payload         Json
  status          PaystackEventStatus @default(RECEIVED)
  processedAt     DateTime?
  error           String?
  createdAt       DateTime            @default(now())

  @@index([eventType])
}
