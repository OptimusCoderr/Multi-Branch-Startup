DATABASE_URL="postgresql://user:password@localhost:5432/inventory_dev?schema=public"
# Least-privilege role the app connects as at runtime — see README.md
# "Least-privilege runtime role" for how to create it and apply
# prisma/grants.sql. Falls back to DATABASE_URL if unset (fine for a
# quick local try, but every real deployment should set this).
RUNTIME_DATABASE_URL="postgresql://inventory_runtime:password@localhost:5432/inventory_dev?schema=public"

BETTER_AUTH_SECRET="generate-a-random-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Paystack — get test-mode keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Webhook URL to register in the Paystack dashboard:
#   <BETTER_AUTH_URL>/api/webhooks/paystack

# Termii — get an API key from https://accounts.termii.com. Used for
# automated customer debt-reminder SMS (off by default per company).
TERMII_API_KEY=""
TERMII_SENDER_ID="Inventory"

# Shared secret Vercel Cron sends as `Authorization: Bearer <this>` when
# calling /api/cron/debt-reminders — generate a random value per
# environment (e.g. `openssl rand -base64 32`) and set the same value in
# your Vercel project's environment variables.
CRON_SECRET=""
